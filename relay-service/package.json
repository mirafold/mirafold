{
  "name": "genui-relay",
  "version": "0.1.0",
  "private": true,
  "description": "The genui-shell hosted relay — a dumb, E2E-blind WebSocket forwarder that pairs a local daemon with remote browser viewports.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --import tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
