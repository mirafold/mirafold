{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@protocol": ["./server/protocol.ts"],
      "@registry-spec": ["./server/registry-spec.ts"],
      "@relay-crypto": ["./server/relay-crypto.ts"]
    }
  },
  "include": ["server", "web/src", "vite.config.ts"]
}
