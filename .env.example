# Which terminal agent genui-shell re-skins. Default: claude-code.
# (codex, gemini-cli — Phase P.2+.) An agent with no credentials below runs
# the API-free mock stand-in instead.
GENUI_AGENT=claude-code

# claude-code credentials (any one makes the session live; else → mock).
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-sonnet-4-6

# codex credentials (Phase P.2): an OPENAI_API_KEY, OR a `codex login` (ChatGPT
# subscription — the SDK reads ~/.codex/auth.json). Either makes it live.
# Sandbox/approval are NOT set here — Codex inherits your own ~/.codex/config.toml
# (faithful skin). CODEX_MODEL is optional; unset → Codex's own default model.
OPENAI_API_KEY=
CODEX_MODEL=

# gemini-cli credentials (Phase P.5): a Google AI Studio API key
# (https://aistudio.google.com/apikey — free tier, no billing). NOTE: the free
# "Login with Google" OAuth path was deprecated by Google for the CLI in 2026
# (IneligibleTierError), so the API key is the working free path. GEMINI_MODEL
# is optional; unset → Gemini's own default model.
GEMINI_API_KEY=
GEMINI_MODEL=

PORT=3000
