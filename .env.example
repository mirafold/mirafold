# Which terminal agent Mirafold re-skins. Default: claude-code.
# (codex, gemini-cli — Phase P.2+.) An agent with no credentials below runs
# the API-free mock stand-in instead.
MIRAFOLD_AGENT=claude-code

# claude-code credentials — set ONE of these to make it live (else → demo mock):
#   - ANTHROPIC_API_KEY (metered API key) — the supported path for Claude here.
#   - ANTHROPIC_AUTH_TOKEN and/or ANTHROPIC_BASE_URL (proxy / gateway / local
#     endpoint setups, e.g. Ollama — the Agent SDK reads both). A local endpoint
#     is BYO — anything goes, local and over the relay. (A RUNNING Ollama is
#     also discovered automatically and offered at onboarding with its models —
#     no env needed for that route; see docs/local-models.md.)
# NOTE: a Claude subscription login (`claude` in a terminal) is NOT a supported
# path — Anthropic's terms don't allow using a Pro/Max subscription in a
# third-party app, so Mirafold won't drive it (the picker will say so and
# point you here). This is Anthropic's rule, not ours. Use an API key.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
# DEFAULT_MODEL is optional. Leave it unset and Claude Code uses its OWN
# configured default model — the same one your terminal uses (faithful skin).
# Set it only to pin a specific model, e.g. DEFAULT_MODEL=claude-sonnet-5.
DEFAULT_MODEL=

# codex credentials (Phase P.2): an OPENAI_API_KEY, OR a `codex login` (ChatGPT
# subscription — the SDK reads ~/.codex/auth.json). The subscription path is a
# DISCLOSED GRAY AREA (provider-policy K.3, 2026-07-15): OpenAI has published
# no general permission for subscription use in third-party tools but visibly
# tolerates it — Mirafold allows it locally and says exactly that at onboarding
# (your account, your call). Anthropic + Google prohibit theirs in writing.
# NOTE: only an API key works over the paid relay; a subscription session is
# served locally but always refused remotely (the closed-model reselling line).
# LOCAL Codex: a RUNNING Ollama/LM Studio/vLLM is discovered automatically and
# offered at onboarding — pick a model there, no config needed. A DEFAULT
# provider in ~/.codex/config.toml (local, or a hosted open-model API like
# OpenRouter — one key, most open models) is detected too and offered as its
# own endpoint row — no key needed here (see docs/local-models.md).
# CODEX_MODEL is optional;
# unset → Codex's own default model. Sandbox/approval are NOT set here — Codex
# inherits your own ~/.codex/config.toml (faithful skin).
OPENAI_API_KEY=
CODEX_MODEL=

# gemini-cli credentials (Phase P.5): a Google AI Studio API key
# (https://aistudio.google.com/apikey — free tier, no billing). NOTE: a Gemini
# subscription (Google AI Pro/Ultra / Code Assist for individuals) is NOT a
# supported path — Google's terms don't allow subscription use in third-party
# tools, and Google cut those tiers off from the Gemini CLI in 2026. The API
# key is the path here. GEMINI_MODEL is optional; unset → Gemini's own default.
GEMINI_API_KEY=
GEMINI_MODEL=

PORT=3000

# Local model server discovery (optional; see docs/local-models.md). The daemon
# probes localhost's well-known runtime ports (Ollama 11434, LM Studio 1234,
# vLLM 8000, llama.cpp 8080) and offers what it finds at onboarding.
# MIRAFOLD_LOCAL_ENDPOINTS: extra URLs to probe (nonstandard ports), comma-
# separated. MIRAFOLD_LOCAL_DISCOVERY=off disables the well-known-port probing
# (env-listed endpoints are still honored).
MIRAFOLD_LOCAL_ENDPOINTS=
MIRAFOLD_LOCAL_DISCOVERY=

# Remote access (Phase R) — both optional; unset = local-only, nothing dials out.
# MIRAFOLD_RELAY_URL: the relay the daemon dials so phones can reach it
# (wss://relay.mirafold.sh for the hosted one; ws://localhost:8080 for a local
# relay). The pairing code is minted fresh each launch (or pinned with
# MIRAFOLD_RELAY_CODE, min 16 chars — shorter is refused).
# MIRAFOLD_APP_URL: the static origin the "connect a device" QR points at —
# where a phone's browser loads the viewport app FROM (the relay itself serves
# no JS by design). Unset = the QR points at the relay URL's HTTP twin, which
# only works when that host serves the app too (dev stub / self-host).
MIRAFOLD_RELAY_URL=
MIRAFOLD_APP_URL=
