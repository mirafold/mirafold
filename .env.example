# Which terminal agent genui-shell re-skins. Default: claude-code.
# (codex, gemini-cli — Phase P.2+.) An agent with no credentials below runs
# the API-free mock stand-in instead.
GENUI_AGENT=claude-code

# claude-code credentials (any one makes the session live; else → mock).
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-sonnet-4-6
PORT=3000
