{
  "name": "mirafold",
  "version": "0.3.7",
  "description": "A faithful browser re-skin of the terminal coding agent you already use — Claude Code, Codex, or Gemini CLI — with generative UI layered on top.",
  "license": "MIT",
  "type": "module",
  "author": "Kyle Serrecchia (https://github.com/kserrec)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafold/mirafold.git"
  },
  "homepage": "https://github.com/mirafold/mirafold#readme",
  "bugs": {
    "url": "https://github.com/mirafold/mirafold/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "gemini-cli",
    "coding-agent",
    "generative-ui",
    "terminal",
    "mcp"
  ],
  "bin": {
    "mirafold": "bin/mirafold.js"
  },
  "files": [
    "bin/",
    "dist/",
    "dist-server/",
    "SECURITY.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "@hono/node-server": "^2.0.5",
    "shell-quote": "^1.9.0",
    "nanoid": "^3.3.17"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "shell-quote": "^1.9.0",
    "nanoid": "^3.3.17"
  },
  "scripts": {
    "dev:server": "MIRAFOLD_TOKEN= tsx watch server/index.ts",
    "dev:web": "vite",
    "dev": "concurrently -n server,web -c blue,green \"yarn dev:server\" \"yarn dev:web\"",
    "build": "vite build && yarn build:server",
    "build:server": "esbuild server/index.ts server/render-mcp.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server",
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"server/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "test:server": "node --import tsx --test --test-concurrency=1 \"server/**/*.itest.ts\"",
    "test:e2e": "yarn build && node --import tsx --test --test-concurrency=1 \"server/**/*.e2e.ts\"",
    "test:ui": "yarn build && node --import tsx --test --test-concurrency=1 \"server/**/*.uitest.ts\"",
    "test:ui:update-snapshots": "yarn build && MIRAFOLD_UPDATE_UI_SNAPSHOTS=1 node --import tsx --test --test-concurrency=1 \"server/testing/ui-visual.uitest.ts\"",
    "test:live": "node --import tsx --test --test-concurrency=1 \"server/**/*.ltest.ts\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.147.0",
    "@parcel/watcher": "^2.6.0",
    "express": "^5.2.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "4.10.2",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.16.1",
    "playwright-core": "^1.61.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
